# Copy to `.env` (gitignored) and fill in. KEY=value lines, no quotes needed.
#
# VASK_KEY is the PUBLIC app key (Pusher-protocol app_key) — visible to every
# browser by design. The app SECRET never goes here or anywhere in this repo:
# it lives server-side in the presence-auth signer (Worker secret / Laravel .env).

VASK_KEY=
VASK_WS_HOST=wss.vask.dev
VASK_WS_PORT=443
VASK_FORCE_TLS=true

# Local testing WITHOUT Vask (soketi, see README "Test multiplayer locally"):
# VASK_KEY=app-key
# VASK_WS_HOST=127.0.0.1
# VASK_WS_PORT=6001
# VASK_FORCE_TLS=false
VASK_AUTH_ENDPOINT=/api/vask/auth
